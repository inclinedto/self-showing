# 复制为 .env.local（本地开发）或填到 Vercel 项目的 Environment Variables（线上）。
# 所有值都可以先留空：缺什么，对应功能就显示“即将开放”或进入演示模式，网站照常能打开。

# ---- 数据库（账号、额度、树洞、提问箱、订单都存在这里） ----
# 线上：在 Vercel 项目里添加 Neon Postgres，会自动注入 DATABASE_URL / POSTGRES_URL。
# 请使用带连接池（pooler）的连接串。
DATABASE_URL=
# 本地开发不填 DATABASE_URL 时自动使用内置的 PGlite，数据存在 .data/pglite。
# USE_PGLITE=1 可强制使用 PGlite；PGLITE_DIR=memory 表示只放内存、重启即清空。
USE_PGLITE=
PGLITE_DIR=

# ---- 站点 ----
# 管理员用户名，多个用英文逗号分隔。先用这个用户名注册，登录后菜单里会出现“管理后台”。
ADMIN_USERNAMES=
# 设置后注册需要填写邀请码（适合内测阶段）；留空表示开放注册。
INVITE_CODE=
# 用于生成评论匿名昵称的密钥。留空时自动生成并保存在数据库里，一般不用填。
APP_SECRET=
# 额外的屏蔽词，英文逗号分隔。
BLOCKED_WORDS=
# 仅本地用 http 测试生产构建时设为 1，线上不要设置。
INSECURE_COOKIES=

# ---- AI 模型：任意 OpenAI 兼容接口，默认是阿里云百炼（通义千问） ----
# 不填 AI_API_KEY 时进入演示模式：工具返回示例数据，不会产生费用。
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 文档问答、AI 小助手用的文本模型
AI_TEXT_MODEL=qwen-plus
# 表格提取用的视觉模型（必须支持图片输入）
AI_VISION_MODEL=qwen-vl-max

# ---- 爱发电支付 ----
# 在 https://afdian.com/dashboard/dev 获取 user_id 和 API Token。
# 套餐价格和爱发电方案 ID 填在 src/resources/plans.ts。
AFDIAN_USER_ID=
AFDIAN_TOKEN=
# 可选：给 Webhook 地址加一个暗号，例如设为 abc 后，Webhook 填 https://你的域名/api/pay/afdian?key=abc
AFDIAN_WEBHOOK_KEY=
# 一般不用改
AFDIAN_BASE_URL=https://afdian.com
